  <ItemGroup>
    <Compile Remove="_diagproj/**/*.cs" />
    <Compile Remove="_game_decomp/**/*.cs" />
    <Compile Remove="_ref_decomp/**/*.cs" />
    <Compile Remove="_tmp_*.cs" />
    <Compile Remove="_tmp_decomp_custommainmenus/**/*.cs" />
    <Compile Remove="_diag.cs" />
    <Compile Remove="_ed_decomp/**/*.cs" />
    <Compile Remove="_api_decomp/**/*.cs" />
    <Compile Remove="_bbadvanced_decomp/**/*.cs" />
    <Compile Remove="_nocomment_bak/**/*.cs" />
    <Compile Remove="_fastloader_src/**/*.cs" />
    <Compile Remove="_fastloader_decomp/**/*.cs" />
    <None Remove="*.logbak" />
  </ItemGroup>
  <Target Name="DeployToGame" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(GameRoot)/BepInEx/plugins/MilkItem/" />
  </Target>
</Project>